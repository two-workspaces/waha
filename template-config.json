{
  "services": {
    "766764de-1566-43d1-bf3c-2975ec5634e7": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/waha/main/icon.png",
      "name": "WAHA",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/ping",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "devlikeapro/waha:gows-2026.9.2"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:3000": {
            "port": 3000
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {
        "480cf293-5ec9-4170-a0c7-d6e2e546598e": {
          "mountPath": "/app/data"
        }
      },
      "variables": {
        "WAHA_API_KEY": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "API key - send it as the X-Api-Key header (also the key the dashboard asks for)",
          "isOptional": false
        },
        "WAHA_DASHBOARD_USERNAME": {
          "defaultValue": "admin",
          "description": "Dashboard and Swagger login",
          "isOptional": false
        },
        "WAHA_DASHBOARD_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Dashboard and Swagger password",
          "isOptional": false
        },
        "WHATSAPP_SWAGGER_USERNAME": {
          "defaultValue": "${{WAHA_DASHBOARD_USERNAME}}",
          "description": "Swagger login (same as the dashboard)",
          "isOptional": false
        },
        "WHATSAPP_SWAGGER_PASSWORD": {
          "defaultValue": "${{WAHA_DASHBOARD_PASSWORD}}",
          "description": "Swagger password (same as the dashboard)",
          "isOptional": false
        },
        "WHATSAPP_DEFAULT_ENGINE": {
          "defaultValue": "GOWS",
          "description": "GOWS = lightweight Go engine, no browser. WEBJS needs the Chrome image and far more RAM",
          "isOptional": false
        },
        "WAHA_BASE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in webhook media links",
          "isOptional": false
        },
        "WAHA_LOCAL_STORE_BASE_DIR": {
          "defaultValue": "/app/data/sessions",
          "description": "WhatsApp sessions on the volume, so redeploys don't log you out",
          "isOptional": false
        },
        "WHATSAPP_FILES_FOLDER": {
          "defaultValue": "/app/data/media",
          "description": "Downloaded media on the volume",
          "isOptional": false
        },
        "WAHA_PRINT_QR": {
          "defaultValue": "False",
          "description": "Don't print QR codes into the logs",
          "isOptional": false
        },
        "WAHA_LOG_FORMAT": {
          "defaultValue": "JSON",
          "description": "Structured logs for Railway's log viewer",
          "isOptional": false
        },
        "UV_THREADPOOL_SIZE": {
          "defaultValue": "16",
          "description": "Node I/O threads (the image would size it from the host's 48 cores)",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "3000",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        }
      }
    }
  }
}